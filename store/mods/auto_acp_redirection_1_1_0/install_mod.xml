		<title lang="en"><![CDATA[Auto ACP redirection]]></title>
		<description lang="en"><![CDATA[After logging into your ACP, this will instantly redirect you to your ACP. No more "Successfully logged into your ACP" page.]]></description>
		<author-notes lang="en"><![CDATA[Thanks!]]></author-notes>
		<author-group>
			<author>
				<realname><![CDATA[Elias]]></realname>
				<username><![CDATA[Elias]]></username>
			</author>
		</author-group>
		<mod-version>1.1.0</mod-version>
		<installation>
			<level>easy</level>
			<time>120</time>
			<target-version>3.0.10</target-version>
		</installation>
	</header>
	<action-group>
		<open src="includes/functions.php">
			<edit>
				<find><![CDATA[meta_refresh(3, $redirect);
      trigger_error($message . '<br /><br />' . sprintf($l_redirect, '<a href="' . $redirect . '">', '</a>'));
		} ]]></find>
				<action type="before-add"><![CDATA[if(!$admin)
            {
               redirect($redirect);
            }
            else
            {
               redirect(append_sid("index.$phpEx"));
            }]]></action>
			</edit>
		</open>
	</action-group>

{
    "name": "esp/guestpseudonyms",
    "type": "phpbb-extension",
    "description": "Show bogus (pseudonymous) usernames to guests and bots — including in mentions and quoted posts — so members' real chosen names are not publicly exposed.",
    "homepage": "https://codeberg.org/elaurijssens/guest-pseudonyms",
    "version": "1.3.3",
    "time": "2026-09-19",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Emma Laurijssens van Engelenhoven",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "composer/installers": "~1.0",
        "phpbb/phpbb": ">=3.3.15,<4.0.0@dev"
    },
    "extra": {
        "display-name": "Guest Pseudonyms",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.15,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/guest_pseudonyms",
            "filename": "version_check",
            "ssl": true
        }
    }
}

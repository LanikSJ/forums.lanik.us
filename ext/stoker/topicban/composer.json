{
    "name": "stoker/topicban",
    "type": "phpbb-extension",
    "description": "Allows administrators and moderators to ban users from posting in individual topics.",
    "homepage": "https://phpbb3bbcodes.com/",
    "version": "1.0.2",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Stoker",
            "homepage": "https://phpbb3bbcodes.com/",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "composer/installers": "~1.0",
        "phpbb/phpbb": ">=3.3.4,<4.0.0@dev"
    },
    "extra": {
        "display-name": "Topic Ban",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.4,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/topic_ban",
            "filename": "version_check",
            "ssl": true
        }
    }
}
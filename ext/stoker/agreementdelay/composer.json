{
    "name": "stoker/agreementdelay",
    "type": "phpbb-extension",
    "description": "Delays the registration agreement button with server-side validation",
    "homepage": "https://phpbb3bbcodes.com",
    "version": "1.0.3",
    "time": "2026-02-01",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Stoker",
            "homepage": "https://phpbb3bbcodes.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpbb/phpbb": ">=3.3.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Agreement Delay",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/agreement_delay",
            "filename": "version_check",
            "ssl": true
        }
    }
}
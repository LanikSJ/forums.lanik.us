{
    "name": "stoker/urlrewrite",
    "type": "phpbb-extension",
    "description": "Converts default phpBB URLs into human-readable URLs (Apache and NGINX).",
    "homepage": "https://phpbb3bbcodes.com/",
    "version": "1.0.9",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "stoker",
            "homepage": "https://phpbb3bbcodes.com/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0",
        "phpbb/phpbb": ">=3.3.15,<4.0.0@dev"
    },
    "extra": {
        "display-name": "User Friendly URLs",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.15,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/user_friendly_urls",
            "filename": "version_check",
            "ssl": true
        }
    }
}
{
    "name": "stoker/maintenance",
    "type": "phpbb-extension",
    "description": "Scheduled maintenance mode with a live countdown, progress bar, and pre-maintenance header banner.",
    "homepage": "https://phpbb3bbcodes.com/",
    "version": "1.1.0",
    "time": "2026-09-03",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "stoker",
            "homepage": "https://phpbb3bbcodes.com/",
            "role": "Developer/Founder"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0",
        "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
    },
    "extra": {
        "display-name": "Board Maintenance",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/board_maintenance",
            "filename": "version_check",
            "ssl": true
        }
    }
}
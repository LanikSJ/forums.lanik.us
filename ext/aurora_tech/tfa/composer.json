{
    "name": "aurora_tech/tfa",
    "type": "phpbb-extension",
    "description": "TOTP Two Factor Authentication (RFC 6238) extension for phpBB 3.3.x on PHP 8",
    "homepage": "https://worktree.ca/bforcier/phpbb-tfa",
    "support": {
        "issues": "https://worktree.ca/bforcier/phpbb-tfa/issues",
        "source": "https://worktree.ca/bforcier/phpbb-tfa"
    },
    "version": "1.0.5",
    "keywords": ["phpbb", "extension", "tfa", "2fa", "totp", "two-factor-authentication", "security"],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Bruno Forcier",
            "email": "bruno.forcier@aurora-tech.systems",
            "homepage": "https://aurora-tech.systems",
            "role": "Lead maintainer — Inspired by paul999 and Bastien59960"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "~1.0",
        "robthree/twofactorauth": "^3.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload-dev": {
        "psr-4": {
            "aurora_tech\\tfa\\": ""
        }
    },
    "extra": {
        "display-name": "Two Factor Authentication",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}

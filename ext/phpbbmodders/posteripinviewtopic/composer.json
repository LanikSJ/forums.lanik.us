{
    "name": "phpbbmodders/posteripinviewtopic",
    "type": "phpbb-extension",
    "description": "Allows moderators and administrators to view the IP of the poster when viewing a topic.",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "1.2.3",
    "time": "2026-10-22",
    "keywords": [
        "phpbb",
        "extension",
        "tools"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
        {
            "name": "Rich McGirr",
            "role": "Past Developer"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "extra": {
        "display-name": "Poster IP in Viewtopic",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/poster_ip_in_viewtopic",
            "filename": "version_check",
            "ssl": true
        }
    }
}
